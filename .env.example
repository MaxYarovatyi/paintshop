# Supabase project (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin without a trailing slash. Used for canonical URLs, sitemap
# and the admin link in Telegram notifications.
NEXT_PUBLIC_SITE_URL=https://example.com

# Telegram bot for inquiry notifications (server only, secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
