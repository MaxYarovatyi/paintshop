# Supabase project (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin without a trailing slash. Used for canonical URLs, sitemap
# and the admin link in Telegram notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram bot for inquiry notifications (server only, secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Supabase secret key (sb_secret_...). Server only. Bypasses RLS: never expose it.
SUPABASE_SECRET_KEY=

# Random string, 32+ characters. Signs the form timestamp (minimum fill time).
# Generate with: openssl rand -hex 32
FORM_SIGNING_SECRET=

# Random string. Salt for hashing IPs used by the rate limit. Do not change it
# casually: old hashes stop matching.
IP_HASH_SALT=

# Cloudflare Turnstile. For local development use Cloudflare's documented test keys:
#   site key  1x00000000000000000000AA   (always passes)
#   secret    1x0000000000000000000000000000000AA
# In production create a real widget in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
